---
import Layout from "../layouts/Layout.astro";

const title = "Página não encontrada — Vilanova";
const description = "O conteúdo que você procura não existe neste acervo.";
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-[#F5EBE0] flex items-center justify-center p-6">
    <div class="text-center max-w-md">
      <h1 class="font-serif text-3xl font-bold text-[#2E5266] mb-4">
        Página não encontrada
      </h1>
      <p class="text-[#2E5266]/80 mb-6">{description}</p>
      <a href="/" class="text-[#C84B31] font-semibold hover:underline">← Voltar ao início</a>
    </div>
  </div>
</Layout>
